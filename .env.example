# Server-only configuration. Never commit .env or credentials.
DATA_DIR=./data
GOOGLE_DRIVE_FOLDER_ID=
# Option A: share the folder with this service account's email.
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: OAuth offline refresh credentials (drive.readonly scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# No fallback model. The only accepted official model ID is gpt-6-luna.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: directory containing Japanese Tesseract .traineddata files.
# TESSDATA_PREFIX=/absolute/path/to/tessdata
# Personal app defaults to localhost. Add exact hosts only for a trusted deployment.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
